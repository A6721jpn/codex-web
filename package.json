{
  "name": "codex-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "preflight": "node --disable-warning=ExperimentalWarning src/server/preflight-cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.ts",
    "m0:probe": "node src/m0/codex-app-server-probe.ts",
    "m0:generate-protocol": "node src/m0/generate-protocol.ts",
    "m0:check": "npm test && npm run m0:generate-protocol && npm run m0:probe -- --prompt \"M0 smoke: reply with one short sentence.\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
